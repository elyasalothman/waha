{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Native open/save dialogs and reading/writing only the files the user picks.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://waha.hajdah.com/*"
        },
        {
          "url": "https://lab.alhajda.com/math"
        },
        {
          "url": "https://github.com/elyasalothman/waha/issues/new*"
        }
      ]
    },
    "fs:allow-open",
    "fs:allow-write",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}

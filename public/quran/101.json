{"number":101,"name":"سُورَةُ القَارِعَةِ","ayahs":[{"number":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","juz":30},{"number":2,"text":"مَا ٱلْقَارِعَةُ","juz":30},{"number":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","juz":30},{"number":4,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","juz":30},{"number":5,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","juz":30},{"number":6,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","juz":30},{"number":7,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","juz":30},{"number":8,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","juz":30},{"number":9,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","juz":30},{"number":10,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","juz":30},{"number":11,"text":"نَارٌ حَامِيَةٌۢ","juz":30}]}
{"number":93,"name":"سُورَةُ الضُّحَىٰ","ayahs":[{"number":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","juz":30},{"number":2,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ","juz":30},{"number":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","juz":30},{"number":4,"text":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","juz":30},{"number":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","juz":30},{"number":6,"text":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","juz":30},{"number":7,"text":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","juz":30},{"number":8,"text":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","juz":30},{"number":9,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","juz":30},{"number":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","juz":30},{"number":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","juz":30}]}
{"number":102,"name":"سُورَةُ التَّكَاثُرِ","ayahs":[{"number":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","juz":30},{"number":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","juz":30},{"number":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","juz":30},{"number":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","juz":30},{"number":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","juz":30},{"number":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","juz":30},{"number":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","juz":30},{"number":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","juz":30}]}
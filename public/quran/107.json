{"number":107,"name":"سُورَةُ المَاعُونِ","ayahs":[{"number":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","juz":30},{"number":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","juz":30},{"number":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","juz":30},{"number":4,"text":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","juz":30},{"number":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","juz":30},{"number":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","juz":30},{"number":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","juz":30}]}
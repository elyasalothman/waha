{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","ayahs":[{"number":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","juz":30},{"number":2,"text":"ٱللَّهُ ٱلصَّمَدُ","juz":30},{"number":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","juz":30},{"number":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","juz":30}]}
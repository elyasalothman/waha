{"number":114,"name":"سُورَةُ النَّاسِ","ayahs":[{"number":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","juz":30},{"number":2,"text":"مَلِكِ ٱلنَّاسِ","juz":30},{"number":3,"text":"إِلَٰهِ ٱلنَّاسِ","juz":30},{"number":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","juz":30},{"number":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","juz":30},{"number":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","juz":30}]}
{"number":109,"name":"سُورَةُ الكَافِرُونَ","ayahs":[{"number":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","juz":30},{"number":2,"text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","juz":30},{"number":3,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","juz":30},{"number":4,"text":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","juz":30},{"number":5,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","juz":30},{"number":6,"text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","juz":30}]}
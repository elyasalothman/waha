{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","ayahs":[{"number":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","juz":30},{"number":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","juz":30},{"number":3,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","juz":30},{"number":4,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","juz":30},{"number":5,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","juz":30},{"number":6,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","juz":30},{"number":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","juz":30},{"number":8,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","juz":30},{"number":9,"text":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","juz":30},{"number":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","juz":30},{"number":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","juz":30},{"number":12,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","juz":30},{"number":13,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","juz":30},{"number":14,"text":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","juz":30},{"number":15,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","juz":30},{"number":16,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","juz":30},{"number":17,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","juz":30},{"number":18,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","juz":30},{"number":19,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","juz":30},{"number":20,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","juz":30},{"number":21,"text":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","juz":30},{"number":22,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","juz":30},{"number":23,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","juz":30},{"number":24,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","juz":30},{"number":25,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","juz":30},{"number":26,"text":"فَأَيْنَ تَذْهَبُونَ","juz":30},{"number":27,"text":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","juz":30},{"number":28,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","juz":30},{"number":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","juz":30}]}
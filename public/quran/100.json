{"number":100,"name":"سُورَةُ العَادِيَاتِ","ayahs":[{"number":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","juz":30},{"number":2,"text":"فَٱلْمُورِيَٰتِ قَدْحًۭا","juz":30},{"number":3,"text":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","juz":30},{"number":4,"text":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","juz":30},{"number":5,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","juz":30},{"number":6,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","juz":30},{"number":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","juz":30},{"number":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","juz":30},{"number":9,"text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","juz":30},{"number":10,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","juz":30},{"number":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","juz":30}]}